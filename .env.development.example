# 复制本文件为 .env.development 后填入你自己的配置
# DeepSeek API 密钥（前端直连旧功能时使用），从 https://platform.deepseek.com 获取
VITE_DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DeepSeek API 基础地址
VITE_DEEPSEEK_API_BASEURL=https://api.deepseek.com
# AI Copilot 后端地址（本地开发默认 8001 端口；部署到云端后改成云端地址）
VITE_COPILOT_API_URL=http://localhost:8001
